<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID (direct download, notarised) - the main app.

  Hardened runtime is on (notarisation requires it); these are the exceptions
  Electron's V8 needs to run at all. Nothing here grants file access: outside
  the sandbox, reading ~/Library/Mail is governed by Full Disk Access, which
  the USER grants in System Settings. The app cannot grant it to itself and
  does not ask for it with an entitlement.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
